# 生产环境变量模板：复制为 .env.prod 后逐项填写
#
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod
#
# 填完用 `docker compose -f compose.prod.yaml --env-file .env.prod config` 校验，
# 有必填项没写会直接报错并指出是哪一项。

# ---- 数据库 ----
POSTGRES_DB=blog
POSTGRES_USER=blog
# 用 openssl rand -base64 24 生成，不要用简单密码
POSTGRES_PASSWORD=

# ---- 认证 ----
# 必填，至少 32 字节：openssl rand -base64 48
JWT_SECRET=
# 服务间调用摘要接口的签名密钥：openssl rand -base64 32
INTERNAL_HMAC_SECRET=

# 首个管理员的初始密码：只在数据库为空时生效，建号后建议从环境变量里删掉
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# 是否允许签发管理员角色的邀请链接
INVITE_ALLOW_ADMIN=false

# ---- 站点 ----
# 用 IP 走 HTTP 时必须为 false；换成域名 + HTTPS 后改为 true
COOKIE_SECURE=false

# ---- AI 服务 ----
AI_ENABLED=true
# mock 不调用外部模型（可用于纯功能验证）；deepseek 需要下面的 key
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-flash
# 访客每日次数（按 IP）
AI_DAILY_LIMIT=8
# 成员每日次数：0 表示不限
AI_MEMBER_DAILY_LIMIT=0
# 关闭思考链：开启后首字延迟明显变长
AI_THINKING=disabled

# ---- 备份 ----
BACKUP_AT=03:10
RETENTION_DAYS=14
