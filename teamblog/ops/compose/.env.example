# TeamBlog 部署配置示例
#
# 用法：cp .env.example .env 然后逐项填写，再 docker compose --env-file ../.env up -d
# 这个文件**不要**提交真实密码（.gitignore 已经排除 .env）。

# ---- 数据库 ----
POSTGRES_DB=blog
POSTGRES_USER=blog
# 生产必须换成长随机串：这个密码等于数据库的最高权限
POSTGRES_PASSWORD=change-me-please

# ---- 应用 ----
# JWT 签名密钥：至少 32 字节。太短启动就会失败（JwtProperties 里有校验）
# 生成：openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-48-bytes-string

# 本地 http 部署填 false；上了 HTTPS 必须改成 true（否则 Cookie 会被浏览器拒绝）
COOKIE_SECURE=false

# Nginx 对外开放的端口
HTTP_PORT=8088

# ---- AI（批次 7）----
# provider=mock 时不调模型，用于验证 SSE 链路；接真模型改成 deepseek / openai
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-flash
# 每人每天的提问上限（成本熔断）
AI_DAILY_LIMIT=20
# 一键关停：改成 false 后两个端点都返回 503
AI_ENABLED=true
# Spring 调 /v1/summarize 时的 HMAC 密钥（两边要一致）
INTERNAL_HMAC_SECRET=change-me-internal