# TeamBlog 部署配置示例
#
# 用法：cp .env.example .env 然后逐项填写，再 docker compose --env-file ../.env up -d
# 这个文件**不要**提交真实密码（.gitignore 已经排除 .env）。

# ---- 数据库 ----
POSTGRES_DB=blog
POSTGRES_USER=blog
# 生产必须换成长随机串：这个密码等于数据库的最高权限
POSTGRES_PASSWORD=change-me-please

# ---- 应用 ----
# JWT 签名密钥：至少 32 字节。太短启动就会失败（JwtProperties 里有校验）
# 生成：openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-48-bytes-string

# 本地 http 部署填 false；上了 HTTPS 必须改成 true（否则 Cookie 会被浏览器拒绝）
COOKIE_SECURE=false

# Nginx 对外开放的端口
HTTP_PORT=8088

# ---- AI（批次 7）----
# provider=mock 时不调模型，用于验证 SSE 链路；接真模型改成 deepseek / openai
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-flash
# 每人每天的提问上限（成本熔断）
AI_DAILY_LIMIT=20
# 一键关停：改成 false 后两个端点都返回 503
AI_ENABLED=true
# Spring 调 /v1/summarize 时的 HMAC 密钥（两边要一致）
INTERNAL_HMAC_SECRET=change-me-internal

# ---- 首启引导 ----
# 只在数据库里一个用户都没有时生效；留空则不创建任何账号。
# 推荐：用一个一次性值，引导完成后立刻从环境变量里删掉。
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# ---- AI 分档 ----
# 访客：便宜模型 + 少额度；成员（带 token）：强模型 + 多额度
AI_ANON_MODEL=deepseek-flash
AI_ANON_DAILY_LIMIT=8
AI_ANON_MAX_ANSWER_CHARS=300
AI_ANON_MAX_TOKENS=600
AI_MEMBER_MODEL=deepseek-flash
AI_MEMBER_DAILY_LIMIT=0
AI_MEMBER_MAX_ANSWER_CHARS=800
AI_MEMBER_MAX_TOKENS=1500
# 思考模式：enabled 更准但首字延迟从 1s 涨到 9s
AI_THINKING=disabled
# 描述+正文少于这个长度，直接给固定提示、不调模型
AI_MIN_USABLE_CONTENT_CHARS=20